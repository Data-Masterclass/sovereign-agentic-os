# Env vars for the Sovereign Agentic OS Docker Compose stack.
# Copy this file to .env before you run `docker compose up`: cp .env.example .env
# Full guide: compose/README.md.
# Or skip the copy: docker compose --env-file .env.example up
#
# Note: compose.yaml sets OS_SESSION_COOKIE_INSECURE=true on os-ui (plain-http
# local dev only). Never set it in a real deployment.

# Local — the default. Copy this file to .env and change nothing.

# Which local services start. Read by Docker Compose itself, not by any app.
# `mock` starts the offline mock-model; see "Model provider" below for openai/stackit.
COMPOSE_PROFILES=mock,postgres-local,litellm-local,langfuse-local

# Postgres superuser name. pg-rw uses this to create the langfuse/litellm DBs on first boot.
POSTGRES_USER=postgres
# Postgres superuser password. Only used on first boot.
POSTGRES_PASSWORD=postgres-local-dev
# Default database the superuser connects to. Only used on first boot.
POSTGRES_DB=postgres
# Points litellm/langfuse-web/langfuse-worker at a different Postgres. Not supported or tested.
# POSTGRES_HOST=my-postgres.example.com
# Database role Langfuse connects with. langfuse-web and langfuse-worker use this.
LANGFUSE_DB_USER=langfuse
# Password for that role.
LANGFUSE_DB_PASSWORD=langfuse-local-dev
# Database role LiteLLM connects with. The litellm service uses this.
LITELLM_DB_USER=litellm
# Password for that role.
LITELLM_DB_PASSWORD=litellm-local-dev

# LiteLLM's admin key. os-ui uses this.
PROXY_MASTER_KEY=sk-litellm-local-dev-master
# LiteLLM's limited key, scoped to the app's own models. agent-runtime uses this.
LITELLM_AGENT_KEY=sk-agents-local-dev

# Model provider. Default `mock` is fully offline. For a real model, pick one:
#   openai : LITELLM_CONFIG=config.openai.yaml, set OPENAI_API_KEY, and drop `mock`
#            from COMPOSE_PROFILES.
#   stackit: LITELLM_CONFIG=config.stackit.yaml, set STACKIT_API_BASE and
#            STACKIT_API_KEY; keep `mock` (embeddings still use the stub).
# Run `docker compose down` first when switching.
LITELLM_CONFIG=config.mock.yaml
# OPENAI_API_KEY=
# STACKIT_API_BASE=
# STACKIT_API_KEY=

# Model alias for quick/worker-tier calls. os-ui reads this.
LITELLM_CHAT_MODEL=sovereign-mock
# Model alias for reasoning-tier calls. os-ui reads this.
LITELLM_REASONING_MODEL=sovereign-reasoning
# Model alias for execution-tier calls. os-ui reads this.
LITELLM_EXEC_MODEL=sovereign-default
# Model alias for quick/worker-tier calls. agent-runtime reads this.
AGENT_RUNTIME_CHAT_MODEL=sovereign-mock
# Model alias for reasoning-tier calls. agent-runtime reads this.
AGENT_RUNTIME_REASONING_MODEL=sovereign-reasoning
# Model alias for execution-tier calls. agent-runtime reads this.
AGENT_RUNTIME_EXECUTION_MODEL=sovereign-default

# Hostname Forgejo reports as its own. forgejo-http and forgejo-init use this.
FORGEJO_DOMAIN=forgejo-http
# Base URL Forgejo builds its own links from. forgejo-http and forgejo-init use this.
FORGEJO_ROOT_URL=http://forgejo-http:3000/
# Seeded Forgejo admin username. forgejo-init creates this user.
FORGEJO_ADMIN_USER=gitea_admin
# Seeded Forgejo admin password.
FORGEJO_ADMIN_PASSWORD=forgejo-admin-local-dev
# Seeded Forgejo admin email.
FORGEJO_ADMIN_EMAIL=admin@datamasterclass.com

# Where agent-runtime sends its model calls.
AGENT_RUNTIME_LITELLM_BASE_URL=http://agentic-os-litellm:4000/v1
# Where agent-runtime sends governed tool calls, back into os-ui.
AGENT_RUNTIME_GOVERNED_TOOL_URL=http://os-ui:3000/api/agents/tool
# Shared token os-ui and agent-runtime use to authenticate each other's calls.
AGENT_RUNTIME_TOKEN=agent-runtime-local-dev-token

# Signs os-ui's login cookie. Production refuses to boot without a real
# value; the placeholder below is for local dev only -- generate your own with `openssl rand -hex 24`.
OS_SESSION_SECRET=os-session-secret-local-dev-change-me
# Seeded os-ui login(s): a JSON array of { id, name, password, domain|domains,
# role }. Password is plaintext here; os-ui hashes it before storing.
OS_USERS=[{"id":"admin","name":"Admin","email":"admin@datamasterclass.com","password":"admin","domains":["platform"],"role":"admin"}]
# Where os-ui sends requests to agent-runtime.
OS_UI_AGENT_RUNTIME_URL=http://agent-runtime:8000
# Where os-ui sends requests to Forgejo.
OS_UI_FORGEJO_URL=http://forgejo-http:3000
# Where os-ui sends its LiteLLM admin/model-info calls.
OS_UI_LITELLM_URL=http://agentic-os-litellm:4000
# Where os-ui sends policy checks, to OPA.
OS_UI_OPA_URL=http://opa:8181
# Where os-ui reads traces from, in Langfuse.
OS_UI_LANGFUSE_URL=http://agentic-os-langfuse-web:3000

# ClickHouse password. Langfuse's analytics store; langfuse-web/worker use this.
CLICKHOUSE_PASSWORD=clickhouse-local-dev
# Valkey password. Langfuse's job queue; langfuse-web and langfuse-worker use this.
VALKEY_PASSWORD=valkey-local-dev
# MinIO root user. Langfuse's blob store; langfuse-web and langfuse-worker use this.
S3_ACCESS_KEY=agentic-os-local
# MinIO root password.
S3_SECRET_KEY=agentic-os-local-secret
# Salt langfuse-web and langfuse-worker use for hashing. Stable on purpose.
LANGFUSE_SALT=sovereign-os-local-dev-salt
# Signs Langfuse's own login session. langfuse-web uses this.
LANGFUSE_NEXTAUTH_SECRET=sovereign-os-local-dev-nextauth-secret
# Encrypts data at rest in Langfuse. Must be 64 hex chars; rotating it would
# orphan already-encrypted data.
LANGFUSE_ENCRYPTION_KEY=a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90
# Public URL Langfuse's login flow redirects to (published on 3002 — os-ui owns 3000, Forgejo owns 3001).
LANGFUSE_NEXTAUTH_URL=http://localhost:3002
# Seeded Langfuse admin email. langfuse-web creates this user on first boot.
LANGFUSE_INIT_USER_EMAIL=alex@datamasterclass.com
# Seeded Langfuse admin display name.
LANGFUSE_INIT_USER_NAME=Alex
# Seeded Langfuse admin password.
LANGFUSE_INIT_USER_PASSWORD=langfuse-local-dev-admin
# Langfuse project key. os-ui and litellm use this to read and write traces.
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-localdev0000public
# Secret half of that same key pair.
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-localdev0000secret
# Where litellm sends its own traces, to Langfuse.
LITELLM_LANGFUSE_HOST=http://agentic-os-langfuse-web:3000

# External — to use a deployed LiteLLM or Langfuse, uncomment a block below
# and comment out the matching values above. For both, uncomment both blocks.

# See compose/README.md → How to run externally → Use a deployed LiteLLM.
# COMPOSE_PROFILES=mock,postgres-local,langfuse-local            # drop litellm-local
# PROXY_MASTER_KEY=<the deployed instance's real master key>     # os-ui's admin key
# LITELLM_AGENT_KEY=sk-agents-local-dev                           # a virtual key from the deployed instance's dashboard
# OS_UI_LITELLM_URL=https://litellm.example.com                   # os-ui -> LiteLLM
# AGENT_RUNTIME_LITELLM_BASE_URL=https://litellm.example.com/v1    # agent-runtime -> LiteLLM
# Set these only if the deployed instance does not serve the sovereign-* aliases.
# Use the model names it does serve — check with: GET /v1/models
# LITELLM_CHAT_MODEL=<a model your instance serves>
# LITELLM_REASONING_MODEL=<a model your instance serves>
# LITELLM_EXEC_MODEL=<a model your instance serves>
# AGENT_RUNTIME_CHAT_MODEL=<a model your instance serves>
# AGENT_RUNTIME_REASONING_MODEL=<a model your instance serves>
# AGENT_RUNTIME_EXECUTION_MODEL=<a model your instance serves>

# See compose/README.md → How to run externally → Use a deployed Langfuse.
# COMPOSE_PROFILES=mock,postgres-local,litellm-local            # drop langfuse-local
# OS_UI_LANGFUSE_URL=https://langfuse.example.com                # os-ui -> Langfuse
# LITELLM_LANGFUSE_HOST=https://langfuse.example.com             # LiteLLM's trace callback -> Langfuse
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-...   # the deployed project's real key pair
# LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-...   # same project, secret half
