# Sovereign Agentic OS — Docker Compose Layer A env vars.
# Copy to .env before `docker compose up` (not committed).

# Profiles: litellm-local / langfuse-local select the bundled (vs external)
# LiteLLM / Langfuse per Phase 2.1's locked profile-swap constraint. Only
# litellm-local's services exist in compose.yaml today (Layer A); langfuse-local
# is listed here for forward-compatibility with the next layer and is currently
# a no-op (no Langfuse service defined yet).
COMPOSE_PROFILES=litellm-local,langfuse-local

# --- Postgres (pg-rw) superuser — used only to run
#     compose/postgres/init/10-extra-databases.sh on first boot. ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-local-dev
POSTGRES_DB=postgres

# --- Per-database roles the init script creates (mirrors values.yaml
#     `postgres.database`/`postgres.username`/local password, and
#     `postgres.extraDatabases[litellm]`). ---
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=langfuse-local-dev
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=litellm-local-dev

# --- LiteLLM (mirrors values.yaml litellmMasterKey / litellmAgentKey.local.value) ---
PROXY_MASTER_KEY=sk-litellm-local-dev-master
LITELLM_AGENT_KEY=sk-agents-local-dev

# --- Forgejo (mirrors values.yaml `forgejo.gitea.admin`/`gitea.config.server`).
#     ${VAR:-default} in compose.yaml so an external Forgejo instance can be
#     swapped in at Layer F without editing compose.yaml itself. ---
FORGEJO_DOMAIN=forgejo-http
FORGEJO_ROOT_URL=http://forgejo-http:3000/
FORGEJO_ADMIN_USER=gitea_admin
FORGEJO_ADMIN_PASSWORD=forgejo-admin-local-dev
FORGEJO_ADMIN_EMAIL=admin@datamasterclass.com

# --- agent-runtime (mirrors values.yaml `agentRuntime` block). LITELLM_API_KEY
#     is NOT set here -- it reuses LITELLM_AGENT_KEY above (the same scoped
#     virtual key litellm-key-init provisions), matching the chart, which reuses
#     the same agent-litellm-key Secret in both places. ---
AGENT_RUNTIME_LITELLM_BASE_URL=http://agentic-os-litellm:4000/v1
AGENT_RUNTIME_CHAT_MODEL=sovereign-mock
AGENT_RUNTIME_REASONING_MODEL=sovereign-reasoning
AGENT_RUNTIME_EXECUTION_MODEL=sovereign-default
# Unreachable until a later layer adds os-ui -- see compose.yaml's agent-runtime
# comment.
AGENT_RUNTIME_GOVERNED_TOOL_URL=http://os-ui:3000/api/agents/tool
AGENT_RUNTIME_TOKEN=agent-runtime-local-dev-token
