# Sovereign Agentic OS UI — multi-stage Next.js production build (standalone, non-root).
#
# Build context = the REPO ROOT (not os-ui/), so the image can bake in the
# per-component docs (docs/components/*.md) the native Components surface serves.
# From the repo root:
#   docker build -t sovereign-os/os-ui:0.1.0 -f images/os-ui/Dockerfile .
#
# The image carries TWO entrypoints: `node server.js` (the Next standalone HTTP server, the
# default CMD) and `node --experimental-strip-types worker/start.mjs` from /app/src (the
# agent-run worker — see the COPY of the source tree below and charts' os-ui-worker.yaml).
#
# Node base pinned by tag (Alpine = small, ships a uid-1000 `node` user we drop to).

# ---- deps: install node_modules from the lockfile ----
FROM node:22.13.1-alpine3.21 AS deps
WORKDIR /app
COPY os-ui/package.json os-ui/package-lock.json ./
RUN npm ci

# ---- builder: compile the standalone server ----
FROM node:22.13.1-alpine3.21 AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY os-ui/ .
RUN npm run build

# ---- runner: minimal runtime, non-root ----
FROM node:22.13.1-alpine3.21 AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    DOCS_DIR=/app/docs/components

# `output: 'standalone'` emits a self-contained server + only the traced deps.
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

# The COMPILE GATE (tabs/software/lib/compile-gate.ts) type-checks app commits against
# the default TS libs + real React types AT RUNTIME. Standalone tracing drops
# .d.ts assets (never require()'d), which made every commit look like hundreds of
# false errors in production. Ship them explicitly; the gate also self-checks and
# skips honestly if these ever go missing again.
COPY --from=deps /app/node_modules/typescript/lib ./node_modules/typescript/lib
COPY --from=deps /app/node_modules/@types/react ./node_modules/@types/react
COPY --from=deps /app/node_modules/@types/react-dom ./node_modules/@types/react-dom
COPY --from=deps /app/node_modules/csstype ./node_modules/csstype

# The compile gate's BUNDLE pass + the Instant-Preview runtime load the esbuild-wasm
# binary at RUNTIME via initialize() — it is never require()'d, so standalone tracing
# drops it (only esbuild-wasm/lib/main.js is traced). Without it the bundle pass threw
# and the WHOLE gate failed open ("gate error — skipped, fail-open") on real commits.
# Ship the wasm explicitly next to its traced package; the gate also self-checks
# (gateBundleAssetReady) and, if this ever goes missing again, skips only the bundle
# net while tsc still gates — instead of failing open.
COPY --from=deps /app/node_modules/esbuild-wasm/esbuild.wasm ./node_modules/esbuild-wasm/esbuild.wasm

# public/ is NOT auto-included in `output: 'standalone'` — copy it explicitly so
# the self-hosted Monaco editor bundle (public/monaco/vs, generated by the
# prebuild copy-monaco step) + favicon/icon are served. Without this the AGENT.md
# / MEMORY.md editor 404s its loader and hangs on "Loading editor…".
COPY --from=builder /app/public ./public

# Bake in the per-component docs so the Components surface reads them natively
# (read straight off disk, no cross-pod fetch).
COPY docs/components ./docs/components

# THE AGENT-RUN WORKER (engine rebuild A4). `output: 'standalone'` traces only what the HTTP
# server requires, so it emits no entry for a process that serves no requests. The `os-ui-worker`
# Deployment therefore runs the TypeScript source directly — `worker/start.mjs` registers the
# tsconfig path aliases (`@core/*`, `@tabs/*`) and Node (>= 22.6) strips the types.
#
# The source lands at /app/src, i.e. ONE level under /app, so bare imports resolve up into the
# standalone `/app/node_modules` (which already carries `@langchain/langgraph`, `pg`, `langfuse`
# and everything else the run path is traced for — they are `serverExternalPackages`).
# `.ts` sources only, plus the two bootstrap `.mjs` files: no build step, no second node_modules,
# and the worker executes byte-for-byte the modules the Next build compiles.
COPY --from=builder /app/worker ./src/worker
COPY --from=builder /app/core   ./src/core
COPY --from=builder /app/tabs   ./src/tabs
COPY --from=builder /app/tsconfig.json ./src/tsconfig.json

# Drop to the built-in non-root `node` user (uid 1000).
USER node

EXPOSE 3000
CMD ["node", "server.js"]
