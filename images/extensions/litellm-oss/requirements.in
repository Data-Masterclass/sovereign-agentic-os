# --- what the `litellm-database` image adds: the Prisma client for the Postgres store -------------
prisma==0.11.0
# psycopg is LGPL-3.0-only and is NOT optional: litellm-proxy-extras 0.4.113 declares it, and both
# migration resolvers import it unguarded (v2: migration_lock.migration_lock, the default; v1:
# request_log_indexes.ensure_request_log_indexes). Measured: without it the db-migrate step exits
# with ModuleNotFoundError. The upstream image ships it too (with psycopg-binary). Owner decision
# pending: licenses/known-violations.json and docs/components/litellm-oss.md "Not yet permissive".
psycopg==3.3.6

# --- from the `proxy-runtime` extra: only what the OS configures ---------------------------------
