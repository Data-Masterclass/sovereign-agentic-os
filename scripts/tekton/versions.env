#
# Pins for the Software Factory's CI engine. ONE place, read by scripts/tekton/install.sh, the kind
# e2e and the chart check. Every release manifest is verified by sha256 before it is applied, so a moved
# URL fails the install instead of installing something else. Upstream sources and licences:
# components/tekton/UPSTREAM.md.

# Tekton Pipelines (LTS line). Images inside the manifest are pinned by digest by upstream.
TEKTON_PIPELINES_VERSION=v1.15.5
TEKTON_PIPELINES_SHA256=c2fe5c2ac98af2984f2d58199e81ef2056802f671051744d986ec998ad19ba84
TEKTON_PIPELINES_URL=https://infra.tekton.dev/tekton-releases/pipeline/previous/v1.15.5/release.yaml

# Tekton Triggers (separately versioned from Pipelines) and its core interceptors (CEL).
TEKTON_TRIGGERS_VERSION=v0.36.5
TEKTON_TRIGGERS_SHA256=4d4d0cf175e7154367a500e48fe4134d2f1450cbfb7f8425496b3b487b3b20c5
TEKTON_TRIGGERS_URL=https://infra.tekton.dev/tekton-releases/triggers/previous/v0.36.5/release.yaml
TEKTON_INTERCEPTORS_SHA256=2097544cefff123dfc4d91cee12ec1b409e10bdbd10362cb8f6ea326eae1de11
TEKTON_INTERCEPTORS_URL=https://infra.tekton.dev/tekton-releases/triggers/previous/v0.36.5/interceptors.yaml

# Tekton Catalog tasks are vendored byte-for-byte under charts/sovereign-agentic-os/files/tekton/tasks/
# (air-gap friendly: no Hub lookup at run time). The commit they were taken from and the sha256 of each
# file are checked by scripts/check-software-tekton-chart.mjs.
TEKTON_CATALOG_COMMIT=112374ce1262b133a77300bd8133445722605e04
TEKTON_TASK_GIT_CLONE_PATH=task/git-clone/0.10/git-clone.yaml
TEKTON_TASK_GIT_CLONE_SHA256=210a4ab39f8a25afa73f5609f4fe7d6095749602ec1ce9beacaee1e01cb7ba2f
TEKTON_TASK_TRIVY_SCANNER_PATH=task/trivy-scanner/0.2/trivy-scanner.yaml
TEKTON_TASK_TRIVY_SCANNER_SHA256=aa5d8055b099f5a0a19c802d9238faced4d06f6df9108ba1c855e114cc0520e9
