#
# CloudNativePG (Apache-2.0): the operator for the App Builder app databases (spec section 7, workstream D). Installed
# by scripts/cnpg/install.sh. The release manifest is sha256-checked; the operator image is pinned by digest in
# install.sh (the upstream manifest names a tag). Verified 2026-11-27: `gh release view v1.30.2 -R
# cloudnative-pg/cloudnative-pg`, `crane digest`, image label org.opencontainers.image.licenses=Apache-2.0, base
# gcr.io/distroless/static-debian13:nonroot.
CNPG_VERSION=1.30.2
CNPG_MANIFEST_URL=https://raw.githubusercontent.com/cloudnative-pg/cloudnative-pg/release-1.30/releases/cnpg-1.30.2.yaml
CNPG_MANIFEST_SHA256=ea4cc355b394e10661d30c6b409cefb19029dd973bccb76b1ed8c789985bc68c
CNPG_IMAGE=ghcr.io/cloudnative-pg/cloudnative-pg:1.30.2
CNPG_IMAGE_DIGEST=sha256:f96f6be3d81ec93819b443c665c575c609342fca840df90d4d87dae314a5b913

# The CANDIDATE operand image (PostgreSQL 18.6, CNPG "minimal" flavour: no extensions, no barman), multi-arch index
# digest. NOT a chart default: it is a Debian 13 userland (bash, coreutils, grep, sed, tar, gnupg, perl, … GPL; glibc
# and others LGPL) around PostgreSQL (PostgreSQL licence), so using it needs the owner's licence decision
# (docs/components/app-databases.md "Licence"). Set it as osUI.software.databases.imageName only after that decision.
CNPG_OPERAND_CANDIDATE=ghcr.io/cloudnative-pg/postgresql:18.6-minimal-trixie@sha256:ec2ed3404e89fff99643901b58a2a34c46a46345fe69a3d96500b82f995c327b

# Install-time sizing (the dev node is CPU-bound): the operator's requests, never a preempting PriorityClass.
CNPG_OPERATOR_CPU_REQUEST=10m
CNPG_OPERATOR_MEMORY_REQUEST=64Mi
# The capacity guard: the install refuses when the node's CPU requests plus the operator's would exceed this share of
# allocatable CPU (the plan's dev capacity gate).
CNPG_MAX_CPU_REQUEST_PERCENT=85
