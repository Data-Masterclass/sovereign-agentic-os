#
# security-profiles-operator (Apache-2.0): the APPROVED FALLBACK that distributes the build pod's Localhost seccomp
# profile (App Builder spec 6.1, workstream C1). Installed by scripts/spo/install.sh, only where
# osUI.software.build.seccomp=localhost (dev). The manifest is sha256-checked; the operator image is pinned by digest
# in install.sh (the upstream manifest names a tag).
SPO_VERSION=v1.1.2
SPO_MANIFEST_URL=https://raw.githubusercontent.com/kubernetes-sigs/security-profiles-operator/v1.1.2/deploy/operator.yaml
SPO_MANIFEST_SHA256=b07e972e898a089333c53cb853f3605fec3557ab61b344c0de811b501e7ca890
SPO_IMAGE=registry.k8s.io/security-profiles-operator/security-profiles-operator:v1.1.2
SPO_IMAGE_DIGEST=sha256:f6ee4402e841e7d5a37d4888b612cf333528820d3a2b1e08101557123d7c5e87

# The base the build pod's profile is derived from (scripts/spo/render-seccomp-profile.mjs): moby/profiles
# seccomp/v0.3.0 default.json, the version BuildKit v0.35.1 vendors.
MOBY_SECCOMP_DEFAULT_SHA256=6416b47770785a41ac59073cdc77d9fe98517df2799dc83ef207e622de3053f6
