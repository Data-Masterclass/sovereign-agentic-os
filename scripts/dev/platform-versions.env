# Platform add-on pins outside the chart, shared by scripts/dev/platform.sh (dev cluster) and the
# kind test scripts/tests/app-ingress-admission.kind.sh, so both install the same release.
# Upstream source, licence and reasons: components/ingress-nginx/UPSTREAM.md.

# ingress-nginx Helm chart (https://kubernetes.github.io/ingress-nginx). Chart 4.15.1 ships
# controller v1.15.1 (image digest pinned inside the chart).
INGRESS_NGINX_CHART_VERSION=4.15.1
INGRESS_NGINX_CONTROLLER_VERSION=v1.15.1
# sha256 of ingress-nginx-4.15.1.tgz as served by the chart repository (helm pull).
INGRESS_NGINX_CHART_SHA256=3eff0bd18151d6e6b1c441463410571443dda1ac78292cb189346628de784f0c
