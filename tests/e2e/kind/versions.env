#
# Pins for the kind acceptance harness (tests/e2e/kind). Only the harness's OWN infrastructure
# is pinned here. Every OS component image comes from the chart (values.yaml + values.local.yaml
# + values.e2e.yaml), so the harness runs exactly what the chart pins and never a second copy.
# Upstream sources and licences: components/{kind,calico,seaweedfs}/UPSTREAM.md.

# kind CLI used in CI (local runs use whatever `kind` is installed; the node image is what matters).
KIND_VERSION=v0.32.0
# Node image from the kind v0.32.0 release notes (Kubernetes 1.35).
KIND_NODE_IMAGE=kindest/node:v1.35.5@sha256:ce977ae6d65918d0b58a5f8b5e940429c2ce42fa3a5619ec2bbc60b949c0ac95

# Calico (manifest install). The manifest is fetched at this tag and verified by sha256 before
# it is applied, so a moved tag fails the run instead of installing something else.
CALICO_VERSION=v3.32.3
CALICO_MANIFEST_SHA256=3db4c55514b678be853be49b8cb102bed0a00bc0343eec05ac191652dc7211e0

# SeaweedFS (S3) — the dev/CI object store (MASTER-PLAN WP-46).
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.51@sha256:f7a49e3f3972ebed5be2ed4befa4a0c68eb7bdddba6e692d42729ceb545134b8

# Helm used by CI (same pin as .github/workflows/ci.yml).
HELM_VERSION=v3.16.3
