# Patterns to ignore when building Helm packages.
.DS_Store
.git
.gitignore
*.swp
*.bak
*.tmp
*.orig
*~
.vscode/
.idea/
# Local-only overlays and notes never belong in the packaged artifact.
values.local.yaml
values.secret.yaml
# Policy unit tests run in CI (test-opa), not in the cluster.
*_test.rego
# Input to scripts/check-capacity.mjs only; no template reads it.
capacity.yaml
capacity.dev.yaml
