kubeconfig.yaml
*.kubeconfig

# OS / editor
.DS_Store
*.swp

# Runtime output pulled from the cluster (not source)
poems/

# install wizard output
values.generated.yaml

# Private instance overlay — registers extra self-hosted model endpoints + extends
# the LiteLLM fallback chain WITHOUT touching public defaults. Instance-specific,
# never published. The committed values.private.example.yaml shows the mechanism;
# the real file (and any private model spec) stays out of git.
values.private.yaml
values.*.private.yaml
stackit/private-instance-models.md

# agent worktrees
.claude/

# Tier-0 OpenSearch migration exports (live platform data — never commit)
.opensearch-migration/
node_modules

# Accidental artifacts — never track (screenshots, DB/metastore backups)
Screenshot *.png
polaris-metastore-backup-*.sql
.pytest_cache/

# Generated code map. Produced by `node scripts/build-docs.mjs` on demand and
# consumed by nobody else: no Pages workflow, nothing serves it at runtime, and
# the OS reads docs/components/*.md directly. It was tracked, and because it is
# ~235k lines regenerated by any docs change, EVERY pair of concurrent branches
# collided on it — five rebases in one week, none of them a real conflict.
docs/site/
